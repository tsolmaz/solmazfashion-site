# Solmaz Fashion AI Proxy - Environment Variables
# Copy this file to .env and fill in your values

# NVIDIA API Key (Gizli - asla client-side'a yazmayın!)
# https://build.nvidia.com/ nemotron-3-ultra sayfasından alınabilir
NVIDIA_API_KEY=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

# Frontend URL (CORS için) - Production'da mutlaka spesifik domain yazın
# Örnek: FRONTEND_URL=https://solmazfashion.com.tr
FRONTEND_URL=*

# AI Proxy Server Port
AI_PORT=3001

# Node Environment
NODE_ENV=development

